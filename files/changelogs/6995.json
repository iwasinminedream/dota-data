      "changed": [
        {
          "type": "localization",
          "name": "DOTA_Tooltip_ability_lycan_pack_hunter_Description",
          "changes": {
            "value": {
              "old": "Lycan and units under his control mark units on attack for %mark_duration% seconds. When Lycan or a unit under his control attacks a marked unit, it deals bonus damage equal to %bonus_damage%%% of its attack damage per stack, and heals the attacker for %lifesteal%%% of its attack damage per stack.",
              "new": "Lycan and units under his control mark units on attack for %mark_duration% seconds. When Lycan or a unit under his control attacks a marked unit, it deals bonus damage equal to %bonus_damage%%% of its attack damage per stack, and heals the attacker for %lifesteal%%% of its attack damage per stack. Only units within %mark_range% range of Lycan can apply new marks.\\n\\nDISPEL TYPE: Basic Dispel"
            }
          }
        },
        {
          "type": "localization",
          "name": "DOTA_Tooltip_ability_chaos_knight_armageddon_Description",
          "changes": {
            "value": {
              "old": "For each second Chaos Knight keeps moving without stopping or attacking, Armageddon gains bonus movement speed. The bonus drains away while stopping, and lost when attacking.<br><br>While at least one of Chaos Knight's phantasms is alive, Ahead, Armageddon can be activated to charge over terrain, building up to a max speed before releasing.  Chaos Knight and the illusions will attack units they charge over.",
              "new": "For each second Chaos Knight keeps moving without stopping or attacking, Armageddon gains bonus movement speed. The bonus drains away while stopping, and lost when attacking.<br><br>While at least one of Chaos Knight's phantasms is alive, Ahead, Armageddon can be activated to charge over terrain, building up to a max speed before releasing.  Chaos Knight and the illusions will attack units they charge over. Can only be activated once per cast of Phantasm, and is refreshed when Phantasm is cast."
            }
          }
        },
        {
          "type": "localization",
          "name": "DOTA_Tooltip_ability_item_horn_of_battle_Description",
          "changes": {
            "value": {
              "old": "<h1>Use: Call to Arms</h1>Target an allied barracks anywhere on the map to summon a wave of mega creeps, including a catapult and a flagbearer, in that lane for your team. Can be used from the backpack.",
              "new": "<h1>Use: Call to Arms</h1>Target an allied barracks anywhere on the map to summon a wave of Super Creeps, or Mega Creeps, if all enemy barracks are destroyed, including a catapult and a flagbearer, in that lane for your team. Can be used from the backpack."
            }
          }
        },
        {
          "type": "localization",
          "name": "DOTA_Tooltip_ability_item_horn_of_battle_greater_Description",
          "changes": {
            "value": {
              "old": "<h1>Use: Grand Call to Arms</h1>Summons a wave of mega creeps, including a catapult and a flagbearer, in every lane for your team. Can be used from the backpack.",
              "new": "<h1>Use: Grand Call to Arms</h1>Summons a wave of super creeps, including a catapult and a flagbearer, in every lane for your team. Can be used from the backpack."
            }
          }
        }
      ]
