        {
          "type": "localization",
          "name": "DOTA_Seasonal_Backstory",
          "value": "Catch up on the backstory"
        },
        {
          "type": "localization",
          "name": "DOTA_Seasonal_PreviousSeasons",
          "value": "Previous seasons:"
        },
        {
          "type": "localization",
          "name": "DOTA_Seasonal_Fall_2026_q05_intro_01",
          "value": "\"Our story so far! Master thief Blake Sextus found out an evil sorcerer named Galdron had a vault full of priceless treasure!"
        },
        {
          "type": "localization",
          "name": "DOTA_Seasonal_Fall_2026_q05_intro_02",
          "value": "So! He hired yours truly and my sister Quintessa to help him steal it!"
        },
        {
          "type": "localization",
          "name": "DOTA_Seasonal_Fall_2026_q05_intro_03",
          "value": "Did it go well? Ha ha! No. No it did not."
        },
        {
          "type": "localization",
          "name": "DOTA_Seasonal_Fall_2026_q05_intro_04",
          "value": "Galdron locked Blake and Quintessa in his vault!"
        },
        {
          "type": "localization",
          "name": "DOTA_Seasonal_Fall_2026_q05_intro_05",
          "value": "Now they're about to run out of water, and air, and all those other things you tend to run out of in a sealed vault."
        },
        {
          "type": "localization",
          "name": "DOTA_Seasonal_Fall_2026_q05_intro_06",
          "value": "If all that sounds confusing, don't worry! It just means you're not a lunatic and you didn't play ten thousand hours of Dota to unlock all that nonsense."
        },
        {
          "type": "localization",
          "name": "DOTA_Seasonal_Fall_2026_q05_intro_07",
          "value": "If you DID play ten thousand hours of Dota and DID unlock all that, forget what I said about you being a lunatic. I was just trying to make these lazy bums feel better."
        },
        {
          "type": "localization",
          "name": "DOTA_Seasonal_Fall_2026_q05_intro_08",
          "value": "There's a hundred and twenty-seven heroes in Dota! But you're the REAL one!"
        },
        {
          "type": "localization",
          "name": "DOTA_Seasonal_Fall_2026_q05_intro_09",
          "value": "Anyway, you can now go back and listen through previous seasons any time you like!\""
        }
      ],
